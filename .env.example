# Groq API key from your Groq Console
GROQ_API_KEY=
# Primary agentic brain. Override this to benchmark another supported Groq model.
GROQ_MODEL=openai/gpt-oss-120b

# Search backend: duckduckgo needs no additional key; searxng requires a URL.
SEARCH_BACKEND=duckduckgo
SEARXNG_URL=

# Conservative defaults for the Groq Free tier.
# GPT-OSS 120B is currently listed at 30 RPM / 1K RPD / 8K TPM / 200K TPD on Free.
MAX_AGENT_STEPS=8
MAX_REQUESTS=40
BRAIN_MIN_INTERVAL_MS=2500
BRAIN_MAX_OUTPUT_TOKENS=1000
REQUEST_TIMEOUT_MS=15000
DATA_DIR=./data
