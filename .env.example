# Brain provider: openrouter or deepseek
BRAIN_PROVIDER=openrouter

# -----------------------------
# OpenRouter
# -----------------------------
# Used only when BRAIN_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional comma-separated fallbacks used only when the primary OpenRouter model/provider fails.
OPENROUTER_FALLBACK_MODELS=

# -----------------------------
# Direct DeepSeek
# -----------------------------
# Used only when BRAIN_PROVIDER=deepseek.
# Direct DeepSeek endpoint: https://api.deepseek.com
DEEPSEEK_API_KEY=
# deepseek-flash is the current V4.1 Flash API model name.
DEEPSEEK_MODEL=deepseek-flash

# Search backend: duckduckgo needs no additional key; searxng requires a URL.
SEARCH_BACKEND=duckduckgo
SEARXNG_URL=

# Local-first execution budgets.
# The model is called at most once per research phase; web/DNS/fetch work is performed locally.
MAX_AGENT_STEPS=3
MAX_REQUESTS=40
BRAIN_MIN_INTERVAL_MS=750
BRAIN_MAX_OUTPUT_TOKENS=900
REQUEST_TIMEOUT_MS=15000
DATA_DIR=./data
