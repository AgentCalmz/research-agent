# OpenRouter API key
OPENROUTER_API_KEY=

# Cost-efficient agentic default: DeepSeek V4.1 Flash supports tools and long-horizon work.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional comma-separated model fallbacks used only when the primary model/provider fails.
# Example: z-ai/glm-5.3
OPENROUTER_FALLBACK_MODELS=

# Search backend: duckduckgo needs no additional key; searxng requires a URL.
SEARCH_BACKEND=duckduckgo
SEARXNG_URL=

# Local-first execution budgets.
# The model is called at most once per phase; web/DNS/fetch work is performed locally.
MAX_AGENT_STEPS=3
MAX_REQUESTS=40
BRAIN_MIN_INTERVAL_MS=750
BRAIN_MAX_OUTPUT_TOKENS=900
REQUEST_TIMEOUT_MS=15000
DATA_DIR=./data
